{
  "name": "srcbin.js",
  "description": "A simple https://sourceb.in api library",
  "version": "2.2.0",
  "license": "GPL-3.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "sourcebin",
    "sourcebin api"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@discordjs/collection": "^2.1.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.0.4"
  },
  "workspaces": [
    "./example/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
